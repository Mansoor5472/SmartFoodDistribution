# ==========================================================
# SMART FOOD DISTRIBUTION PLATFORM - CONFIGURATION
# ==========================================================

# Application Port & Host
PORT=8000
HOST=0.0.0.0

# Database Configuration:
# For MySQL: mysql+pymysql://username:password@localhost:3306/smart_food_db
# For SQLite (instant out-of-the-box local testing): sqlite:///./smart_food.db
DATABASE_URL=sqlite:///./smart_food.db

# JWT Security
SECRET_KEY=smart_food_distribution_super_secret_jwt_key_2026_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Platform Environment
ENVIRONMENT=development
